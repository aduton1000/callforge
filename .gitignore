# ─── CallForge .gitignore ─────────────────────────────────────────────────
# Never commit large data, references, annotation DBs, or run outputs.

# Nextflow run state
work/
work_*/
.nextflow/
.nextflow.log*
results/
results_*/
report.html
timeline.html
trace.txt*
dag.html

# References / indices / annotation databases (discovered locally; never vendored)
refs/
reference/
*.fa
*.fa.gz
*.fasta
*.fasta.gz
*.fai
*.dict
*.amb
*.ann
*.bwt*
*.pac
*.sa
*.0123
*.bwt.2bit.64
vep_cache/
*.gff.gz
*.gtf.gz

# Sequence / alignment / variant data
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.crai
*.sam
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bgz
*.bgz.tbi
*.g.vcf.gz
*.bcf
gnomad*.tbi
gnomad*.bgz*
annotation_db/
*.bed.gz
*.bigWig
*.bw

# Test data is generated locally by test/make_test_data.sh; keep the generator,
# never the products (mini-genome, FASTQs, fixture sample sheet with abs paths).
test/data/

# Local-only / private inputs
_local/
# Per-user working config (contains real machine-specific paths); params.example.yaml
# is the public template. Never track the filled-in copy.
params.full.yaml
params.yaml

# Conda / container build artifacts
*.sif
.create_env.log
__pycache__/
*.pyc

# Python packaging / editable-install artifacts
*.egg-info/
build/
dist/

# Manual: SVG figures are non-deterministic build byproducts (regenerated by
# bin/build_manual.sh from results/ + the DAG .dot). The manual embeds the PNGs,
# not the SVGs, so the SVGs are not part of the committed deliverable.
docs/manual/figures/*.svg

# OS cruft
.DS_Store
