// ═══════════════════════════════════════════════════════════════════════════
//  CallForge — targeted-capture germline analysis pipeline
//  nextflow.config : global params + profiles (test, mac_local, hpc_slurm)
//  Disease- and organism-agnostic: change inputs/config only, no code edits.
//  Analysis counterpart to CaptureForge; consumes its final_covered_targets.bed
//  and per-gene metadata.
// ═══════════════════════════════════════════════════════════════════════════

manifest {
    name            = 'CallForge'
    author          = 'Genomics & Bioinformatics Core'
    description     = 'Targeted-capture germline analysis (FASTQ -> annotated joint callset -> burden)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

// ── Default parameters ──────────────────────────────────────────────────────
// Everything is overridable via -params-file params.yaml or --key value.
params {

    help               = false

    // ---- Inputs ----
    input              = null          // sample sheet CSV (sample_id,fastq_1,fastq_2,sex,phenotype,covariate_*,batch)
    panel_name         = 'callforge_panel'

    // ---- CaptureForge handoff (target + per-gene metadata) ----
    // As-built coverage BED is the target. Metadata drives CNV/STR/paralog/burden.
    target_bed         = null          // final_covered_targets.bed (required)
    captureforge_dir   = null          // optional: results/<run> dir; auto-discovers metrics.json + baits.csv
    cf_metrics_json    = null          // optional explicit path (else found under captureforge_dir)
    cf_baits_csv       = null          // optional explicit path
    // Direct overrides if CaptureForge outputs are absent:
    gene_metadata      = null          // pre-built per-gene metadata TSV (class/cnv_callable/paralog/str/burden_group)
    paralog_genes      = null          // comma list, e.g. 'CD209,CASP1,CR1,HP,CFH'
    str_catalog        = null          // ExpansionHunter variant catalog JSON (else built from STR-class targets)

    // ---- Reference (must equal the CaptureForge design genome: GRCh38 no-alt) ----
    genome_build       = 'GRCh38'
    genome_fasta       = null          // no-alt primary assembly FASTA (required)
    species            = 'homo_sapiens'   // VEP species; set per organism

    // ---- Resource auto-discovery (Stage 0 / §5) ----
    resource_dirs      = "${env('HOME')},/usr/local/share,/opt"   // comma list scanned by discover_resources.py
    resource_manifest  = null          // optional: skip discovery and use this manifest JSON
    allow_download     = false         // never fetch DBs unless missing AND required AND opted in
    // Explicit resource overrides (used as-is, still validated); null => discover.
    vep_cache          = null
    vep_release        = 110
    gnomad_vcf         = null          // prefer a release carrying AFR frequencies
    gnomad_af_field    = 'AF_afr'         // gnomAD SOURCE INFO field (namespaced to gnomAD_AF_afr on output)
    // Genomic-scope gate: a FOUND-but-region-limited annotation DB (e.g. a
    // single-locus gnomAD) silently under-annotates outside its region. Discovery
    // flags such a DB UNFIT and FAILS LOUD by default; never silently skip it.
    scope_min          = 0.9           // min fraction of target contigs a DB must span
    ignore_unfit_resources = false     // set true to proceed despite an unfit DB (not advised)
    dbsnp_vcf          = null
    clinvar_vcf        = null
    phylop_bw          = null
    known_sites        = null          // comma list for BQSR (dbSNP + Mills + 1000G indels)
    vcfanno_toml       = null          // bring-your-own-databases TOML (organism-generic)

    // ---- Stage 2 : trimming (fastp; DBS-appropriate) ----
    adapter_r1         = null          // null => fastp auto-detect
    adapter_r2         = null
    fastp_qual         = 20
    fastp_min_len      = 30

    // ---- Stage 5 : per-sample QC gate thresholds (flag & quarantine; never drop) ----
    min_mean_target_depth = 30         // x
    max_dup_rate          = 0.40       // fraction
    min_on_target         = 0.40       // fraction of reads on target
    max_contamination     = 0.03       // VerifyBamID2 FREEMIX
    enforce_sex_check     = true

    // ---- Stage 6 : SNV/indel calling ----
    caller             = 'gatk'        // gatk | deepvariant
    ploidy             = 2
    joint_method       = 'genomicsdb'  // genomicsdb | combinegvcfs

    // ---- Stage 7 : GATK hard-filters (robust for a targeted panel) ----
    // VQSR only if the cohort is large (document; not default).
    snp_filter_expr    = 'QD<2.0 || FS>60.0 || MQ<40.0 || MQRankSum<-12.5 || ReadPosRankSum<-8.0 || SOR>3.0'
    indel_filter_expr  = 'QD<2.0 || FS>200.0 || ReadPosRankSum<-20.0 || SOR>10.0'

    // ---- Stage 8 : CNV ----
    cnv_caller         = 'cnvkit'      // cnvkit | gatk_gcnv
    cnv_method         = 'hybrid'      // CNVkit: hybrid (capture) | amplicon (targeted, no off-target)
    cnv_segment_method = 'cbs'         // cbs (needs R/DNAcopy) | haar (pure-python) | hmm
    cnv_min_samples_pon = 5            // min QC-pass samples to build a panel-of-normals

    // ---- Stage 9 : STR ----
    str_motif          = 'GT'          // fallback motif when building a catalog from str-class targets

    // ---- Stage 10 : paralog-aware ----
    paralog_min_mq     = 50            // MQ below this in a paralog region -> flagged low-confidence

    // ---- Stage 11 : annotation ----
    vep_image          = 'ensemblorg/ensembl-vep:release_110.0'  // official VEP container
    vep_mode           = 'cache'       // cache (production; --dir_cache) | gtf (offline, no cache)
    gtf                = null          // gene-model GTF for vep_mode=gtf (bgzipped+tabixed)
    vep_extra          = ''            // extra VEP flags (plugins etc.)

    // ---- Stage 12 : cohort QC ----
    somalier_sites     = null          // somalier sites VCF (standard 1000G sites for the build)

    // ---- Stage 13 : GIAB benchmarking ----
    giab_control_id    = null          // sample_id of the GIAB control in the sheet
    giab_truth_vcf     = null          // GIAB truth VCF (v4.2.1); may be fetched if allow_download
    giab_truth_bed     = null          // GIAB high-confidence BED
    happy_image        = 'jmcdani20/hap.py:v0.3.12'   // official hap.py container

    // ---- Stage 14 : burden / association ----
    run_burden         = true          // auto-skipped if no phenotype column present
    burden_engine      = 'regenie'     // regenie | skat
    burden_af_max      = 0.01          // rare threshold on gnomAD-AFR AF
    burden_csq         = 'frameshift_variant,stop_gained,stop_lost,start_lost,splice_acceptor_variant,splice_donor_variant,missense_variant,inframe_insertion,inframe_deletion'
    n_ancestry_pcs     = 4
    covariates         = ''            // comma list of covariate_* columns; '' => all present

    // ---- Output ----
    outdir             = 'results'
    publish_mode       = 'copy'

    // ---- Resource ceilings (overridden per profile) ----
    max_cpus           = 8
    max_memory         = '16.GB'
    max_time           = '24.h'
}

// ── Profiles ────────────────────────────────────────────────────────────────
profiles {
    test      { includeConfig 'conf/test.config'      }
    mac_local { includeConfig 'conf/mac_local.config' }
    hpc_slurm { includeConfig 'conf/hpc_slurm.config' }

    // Container engines (compose with the above, e.g. -profile test,docker)
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    conda {
        conda.enabled  = true
        conda.useMamba = true
    }
}

// base config (resource labels, errorStrategy, reporting) always applied
includeConfig 'conf/base.config'

// ── Nextflow run reporting ───────────────────────────────────────────────────
// Static filenames (overwrite=true); the strict config parser disallows
// arbitrary Groovy (e.g. a timestamp def) at config top level.
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html"      }
