// ── conf/mac_local.config ────────────────────────────────────────────────────
// Full single-machine run on the authoring Mac. Heavy steps (genome indexing,
// joint genotyping, gCNV) run here but are slow on a laptop — the full cohort
// run is intended for the HPC (see hpc_slurm).
//   nextflow run main.nf -profile mac_local,conda -params-file params.full.yaml
params {
    config_profile_name        = 'Mac local (full)'
    config_profile_description = 'Full pipeline on a single macOS machine'

    max_cpus   = 8
    max_memory = '24.GB'
    max_time   = '48.h'
}

process {
    executor = 'local'
}

// Apple Silicon: prefer native osx-arm64 conda builds; tools without them
// (gatk4, bwa-mem2, deepvariant, ...) resolve as x86_64 under Rosetta when the
// env is created with CONDA_SUBDIR=osx-64, and the report flags emulated stages.
conda.useMamba = true
