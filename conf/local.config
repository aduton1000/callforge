// ── conf/local.config ────────────────────────────────────────────────────────
// Run the full pipeline on a SINGLE machine (the `local` execution profile) — any
// Linux or macOS host (Windows via WSL2), laptop or workstation. Not Mac-specific
// and not developer-only; the cohort-scale run is still intended for the cluster
// (see hpc_slurm). `mac_local` remains a deprecated alias for this profile.
//   callforge run -profile local,conda -params-file params.full.yaml
params {
    config_profile_name        = 'Local (single machine)'
    config_profile_description = 'Full pipeline on one Linux/macOS machine'

    // Single-machine ceilings: total concurrent use is capped at these (see the
    // executor block below + the per-label clamp in conf/base.config). Override on
    // the command line, e.g. `--max_cpus 4 --max_memory 8.GB` on a small laptop.
    max_cpus   = 8
    max_memory = '24.GB'
    max_time   = '48.h'
}

process {
    executor = 'local'
}

// Cap TOTAL concurrent resource use on this machine ("use at most N cores / M GB"):
// Nextflow's local executor will not run more tasks at once than these allow.
executor {
    cpus   = params.max_cpus
    memory = params.max_memory
}

// Apple Silicon: prefer native osx-arm64 conda builds; tools without them
// (gatk4, bwa-mem2, deepvariant, ...) resolve as x86_64 under Rosetta when the
// env is created with CONDA_SUBDIR=osx-64, and the report flags emulated stages.
conda.useMamba = true
