// ── conf/test.config ─────────────────────────────────────────────────────────
// Tiny end-to-end run: 2-3 samples (incl. a GIAB-style control), a few small
// genes, a chromosome-subset reference. Completes on a Mac in minutes.
//   nextflow run main.nf -profile test,conda
//
// All test inputs are generated by test/make_test_data.sh from the local GRCh38
// primary FASTA + the CaptureForge target BED (each test gene's locus becomes a
// short contig; paired reads are simulated; a control gets spiked truth variants).
params {
    config_profile_name        = 'Test profile'
    config_profile_description = '2-3 samples on a subset reference, end-to-end in minutes'

    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '1.h'

    panel_name = 'callforge_test'

    input            = "${projectDir}/test/data/test_samplesheet.csv"
    target_bed       = "${projectDir}/test/data/ref/test_targets.bed"
    genome_fasta     = "${projectDir}/test/data/ref/test_genome.fa"
    gene_metadata    = "${projectDir}/test/data/ref/test_gene_metadata.tsv"
    str_catalog      = "${projectDir}/test/data/ref/test_str_catalog.json"
    // CNV-callability metrics (CFH/CR1 breakpoint-blind; others depth-callable)
    cf_metrics_json  = "${projectDir}/test/data/ref/test_metrics.json"
    paralog_genes    = "HP,CR1,CFH,CD209,CASP1"
    // VEP via GTF (no cache needed) for the hermetic test; run with -profile test,docker.
    vep_mode         = 'gtf'
    gtf              = "${projectDir}/test/data/ref/test_genes.gtf.gz"

    // Resource discovery scans the test fixture dir only (keeps it hermetic/fast).
    resource_dirs    = "${projectDir}/test/data/resources"

    // GIAB control + tiny truth restricted to the test contigs.
    giab_control_id  = 'CTRL'
    giab_truth_vcf   = "${projectDir}/test/data/ref/test_truth.vcf.gz"
    giab_truth_bed   = "${projectDir}/test/data/ref/test_truth.bed"
    // somalier sites for the test (autosomal relatedness sites + X sites for sex).
    somalier_sites   = "${projectDir}/test/data/ref/test_somalier_sites.vcf.gz"

    // Burden runs only if the test sheet carries a phenotype column (it does).
    run_burden       = true
    burden_engine    = 'collapse'  // chi2 collapsing — dependency-free, runs on the toy N
    cnv_min_samples_pon = 2        // toy cohort
    // TEST-ONLY permissive consequence set so the synthetic spikes qualify and the
    // collapse machinery is exercised; production uses the strict LoF/missense set
    // in nextflow.config.
    burden_csq = "stop_retained_variant,downstream_gene_variant,missense_variant,stop_gained,frameshift_variant,splice_acceptor_variant,splice_donor_variant,inframe_deletion,inframe_insertion"

    // Light thresholds so the toy cohort is not spuriously quarantined. The fixture
    // intentionally carries off-target X reads (so somalier can infer sex), which
    // lowers on-target% — relax it for the test (LOWQC still quarantines on depth).
    min_mean_target_depth = 5
    min_on_target         = 0.10

    // Mini-genome contains only target regions (no off-target) -> CNVkit amplicon;
    // haar segmentation avoids the R/DNAcopy dependency for the hermetic test.
    cnv_method = 'amplicon'
    cnv_segment_method = 'haar'
}
