// ── conf/hpc_slurm.config ────────────────────────────────────────────────────
// SLURM cluster execution (Ubuntu 24.04; conda at /hpc/opt/conda; SLURM global,
// cluster-wide). Apptainer for containers (Docker usually forbidden).
//   nextflow run main.nf -profile hpc_slurm,apptainer -params-file params.full.yaml
//   # or, with shared conda envs sourced from /hpc/opt/conda:
//   nextflow run main.nf -profile hpc_slurm,conda  -params-file params.full.yaml
//
// Shared-conda convention (Ubuntu cluster):
//   source /hpc/opt/conda/etc/profile.d/conda.sh
//   shared envs live under /hpc/opt/conda/envs/ ; discovered resources are
//   copied to a shared path (see docs/hpc_deployment.md).
params {
    config_profile_name        = 'HPC SLURM'
    config_profile_description = 'SLURM executor + Apptainer/shared-conda on a cluster'

    // Cluster-specific knobs (override on the command line / params file)
    slurm_partition  = 'normal'
    slurm_account    = ''
    slurm_queue_opts = ''
    scratch_dir      = '/tmp'

    max_cpus   = 32
    max_memory = '128.GB'
    max_time   = '72.h'
}

process {
    executor       = 'slurm'
    queue          = { params.slurm_partition }
    clusterOptions = { [ params.slurm_account ? "--account=${params.slurm_account}" : '',
                         params.slurm_queue_opts ].findAll{ it }.join(' ') }
    scratch        = { params.scratch_dir }

    // Heavy steps get a big slot on the cluster.
    withLabel: index { cpus = 16; memory = 64.GB; time = 24.h }
    withLabel: align { cpus = 16; memory = 48.GB; time = 12.h }
    withLabel: large { cpus = 8;  memory = 32.GB; time = 12.h }
}

executor {
    queueSize       = 100
    submitRateLimit = '10/1min'
}

// Centralized container cache shared across cluster users.
params.apptainer_cache = "${env('HOME')}/.apptainer/callforge"
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = params.apptainer_cache
}

// Shared conda env cache (so the cluster builds each env once).
conda {
    useMamba = true
    cacheDir = "${env('HOME')}/.conda/callforge_envs"
}
