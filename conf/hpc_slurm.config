// ── conf/hpc_slurm.config ────────────────────────────────────────────────────
// SLURM cluster execution with Apptainer or SingularityCE (Docker usually forbidden).
//   nextflow run main.nf -profile hpc_slurm,apptainer   -params-file params.full.yaml
//   nextflow run main.nf -profile hpc_slurm,singularity -params-file params.full.yaml
//   # or, with shared conda envs:
//   nextflow run main.nf -profile hpc_slurm,conda       -params-file params.full.yaml
params {
    config_profile_name        = 'HPC SLURM'
    config_profile_description = 'SLURM executor + Apptainer/Singularity on a shared cluster'

    // Cluster-specific knobs (override on the command line / params file).
    // slurm_partition has NO safe default — clusters differ (global, compute, batch,
    // normal, …). Leave it null; main.nf fails loudly under the SLURM executor if it
    // is unset, rather than silently submitting to a partition that may not exist.
    // Set it: --slurm_partition <queue>  or  slurm_partition: <queue> in the params
    // file. Discover valid partitions with `sinfo -s`.
    slurm_partition  = null
    slurm_account    = ''
    slurm_queue_opts = ''
    scratch_dir      = '/tmp'
    // Container bind for referenced-in-place refs (e.g. a VEP cache / gnomAD VCF) is
    // `bind_paths` — defined globally in nextflow.config and applied via
    // process.containerOptions; equivalently `export SINGULARITY_BIND=/path`.

    max_cpus   = 32
    max_memory = '128.GB'
    max_time   = '72.h'
}

process {
    executor       = 'slurm'
    // Only emit -p/--partition when slurm_partition is set (null → omit; main.nf
    // guards against an unset partition before any job is submitted).
    queue          = { params.slurm_partition ?: null }
    clusterOptions = { [ params.slurm_account ? "--account=${params.slurm_account}" : '',
                         params.slurm_queue_opts ].findAll{ it }.join(' ') }
    scratch        = { params.scratch_dir }

    // Heavy steps get a big slot on the cluster.
    // NOTE: conf/base.config is includeConfig'd AFTER the profiles block in
    // nextflow.config, so its withLabel values currently take precedence over these.
    // The EFFECTIVE per-label resources therefore come from conf/base.config; these
    // are kept aligned with it. (bwa-mem2 index sized for the genuine build-needed
    // case — it is SKIPPED when a pre-built index is reused.)
    withLabel: index { cpus = 16; memory = 72.GB; time = 24.h }
    withLabel: align { cpus = 16; memory = 48.GB; time = 12.h }
    withLabel: large { cpus = 8;  memory = 32.GB; time = 12.h }
}

executor {
    queueSize       = 100
    submitRateLimit = '10/1min'
}

// Centralized container-image cache shared across cluster users.
// The container ENGINE is chosen by the packaging profile you compose with
// hpc_slurm — do NOT enable an engine here, or composing the other one would
// leave two engines enabled (Nextflow rejects that). Both run the same .sif:
//   -profile hpc_slurm,apptainer     (Apptainer sites)
//   -profile hpc_slurm,singularity   (SingularityCE sites — no `apptainer` binary)
params.container_cache = "${env('HOME')}/.callforge/container_cache"
params.apptainer_cache = params.container_cache   // back-compat alias
// cacheDir is applied to whichever engine the packaging profile enables; setting
// it on the disabled engine is harmless. autoMounts/envWhitelist come from the
// packaging profile (nextflow.config).
apptainer.cacheDir   = params.container_cache
singularity.cacheDir = params.container_cache

// Shared conda env cache (so the cluster builds each env once).
conda {
    useMamba = true
    cacheDir = "${env('HOME')}/.conda/callforge_envs"
}
