// ── conf/base.config ─────────────────────────────────────────────────────────
// Always-applied defaults: resource labels, retries, error strategy, publishing.

process {

    // Image every task runs inside (empty = native/host). Read by the docker/
    // singularity/apptainer executors, which run e.g. `singularity exec <container> …`.
    // Set via --container_image / params file. Applies to ALL processes EXCEPT those
    // that pin their own official image via a module-level `container` directive
    // (VEP = params.vep_image, hap.py = params.happy_image, DeepVariant = google/deepvariant),
    // which overrides this process-scope default.
    container = params.container_image
    // Bind referenced-in-place refs (params.bind_paths) into every task container.
    // A CLOSURE (resolved per task, AFTER --bind_paths / -params-file merge) — unlike a
    // top-level engine runOptions assignment, which evaluates at parse time and would
    // always see the empty default. null = no extra bind. Composes with autoMounts.
    containerOptions = { params.bind_paths ? "--bind ${params.bind_paths}" : null }

    cpus   = 1
    memory = { 2.GB * task.attempt }
    time   = { 1.h  * task.attempt }

    // 130..145 = signals (incl. OOM 137); 104 = transient I/O. Retry those; else finish.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Per-task requests are CLAMPED to the single-machine ceilings (--max_cpus /
    // --max_memory) via [request, ceiling].min() so no one task ever asks for more
    // than the machine is allowed to use. (The `local` profile additionally caps
    // TOTAL concurrency via its executor block; the hpc_slurm profile overrides
    // these per-label values with its own larger per-job requests.) Inlined closures
    // — the strict config parser forbids a check_max() helper function.
    withLabel: small  { cpus = { [1,                (params.max_cpus as int)].min() }; memory = { [2.GB  * task.attempt, (params.max_memory as nextflow.util.MemoryUnit)].min() }; time = { 1.h  * task.attempt } }
    withLabel: medium { cpus = { [2,                (params.max_cpus as int)].min() }; memory = { [6.GB  * task.attempt, (params.max_memory as nextflow.util.MemoryUnit)].min() }; time = { 4.h  * task.attempt } }
    withLabel: large  { cpus = { [4 * task.attempt, (params.max_cpus as int)].min() }; memory = { [12.GB * task.attempt, (params.max_memory as nextflow.util.MemoryUnit)].min() }; time = { 12.h * task.attempt } }

    // Whole-genome indexing (bwa-mem2 index) and joint genotyping are heavy.
    // bwa-mem2 index of a human genome peaks at ~58 GB RAM — 24 GB starved it and
    // forced OOM retries. Size it realistically (~72 GB, 8 cpus). This runs at most
    // ONCE per reference and is SKIPPED entirely when a pre-built index is reused.
    // (These base values are the EFFECTIVE ones: conf/base.config is includeConfig'd
    // after the profiles block in nextflow.config, so it overrides the per-profile
    // withLabel overrides — bump resources HERE, not only in conf/hpc_slurm.config.)
    withLabel: index  { cpus = { [8, (params.max_cpus as int)].min() }; memory = { [72.GB * task.attempt, (params.max_memory as nextflow.util.MemoryUnit)].min() }; time = { 12.h * task.attempt } }
    withLabel: align  { cpus = { [4 * task.attempt, (params.max_cpus as int)].min() }; memory = { [16.GB * task.attempt, (params.max_memory as nextflow.util.MemoryUnit)].min() }; time = { 8.h  * task.attempt } }
}

// Trace directory for pipeline_info outputs
params.tracedir = "${params.outdir}/pipeline_info"

// NOTE: resource ceilings are applied as explicit per-label values in each
// profile (see max_cpus/max_memory/max_time and the withLabel blocks) rather
// than an nf-core check_max() helper — the Nextflow strict config parser
// disallows function/import declarations in config files.
